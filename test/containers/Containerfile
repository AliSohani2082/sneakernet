# A minimal distro image that boots systemd, for offline install tests.
ARG BASE
FROM ${BASE}
RUN set -e; \
    if [ -x /usr/lib/systemd/systemd ] && command -v ps >/dev/null; then \
        : "systemd is already in the image (Arch)"; \
    elif command -v apt-get >/dev/null; then \
        apt-get update; \
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends systemd systemd-sysv procps; \
        rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf >/dev/null; then \
        dnf -y install systemd procps-ng; dnf clean all; \
    elif command -v pacman >/dev/null; then \
        pacman -Sy --noconfirm --needed systemd procps-ng; pacman -Scc --noconfirm; \
    fi; \
    systemctl mask systemd-firstboot.service systemd-networkd-wait-online.service 2>/dev/null || true
STOPSIGNAL SIGRTMIN+3
CMD ["/usr/lib/systemd/systemd"]
